# ==============================
# GOD'S EYE — Git Ignore
# ==============================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Python testing and linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
htmlcov/

# Node.js / React / Vite
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.vite/
.npm/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Git and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# Local databases
*.sqlite
*.sqlite3
*.db

# Uploaded datasets and generated data
uploads/
data/uploads/
data/raw/
data/processed/
data/cache/
cache/

# Scientific data files
*.nc
*.nc4
*.cdf
*.grib
*.grb
*.zarr/
*.h5
*.hdf5

# Preserve bundled demo datasets
!src/ocean_backend/data/model_3d.nc
!src/ocean_backend/data/model_4d.nc
!src/ocean_backend/data/argo/profiles/1902675_prof.nc

# Model artifacts
artifacts/
checkpoints/
*.pt
*.pth
*.onnx
*.pkl
*.joblib

# Jupyter
.ipynb_checkpoints/

# Browser testing
test-results/
playwright-report/
coverage/